@model _2DRakun.Models.ViewModels.InvoiceViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Predračun @Model.InvoiceNumber</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: #000;
            margin: 20px;
        }

        h2 {
            margin-bottom: 20px;
            text-align: center;
        }

        h4 {
            margin-bottom: 10px;
        }

        .section {
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #000;
            padding: 6px;
        }

        th {
            background-color: #f2f2f2;
        }

        .no-border td {
            border: none;
            padding: 2px 0;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .total {
            font-size: 14px;
            font-weight: bold;
            text-align: right;
            margin-top: 10px;
        }

        .qr-box {
            margin-top: 30px;
            text-align: right;
        }

            .qr-box img {
                width: 280px;
                height: 240px;
            }

        .seller-customer-container {
            width: 100%;
            margin-bottom: 30px;
            display: table;
            table-layout: fixed;
            border-spacing: 20px 0; /* razmak između stupaca */
        }

        .seller-customer-box, .customer-box {
            display: table-cell;
            vertical-align: top;
            width: 50%;
            box-sizing: border-box;
            padding: 0 10px; /* malo unutarnjeg razmaka, možeš prilagoditi */
        }

        .seller-customer-box {
            padding-left: 0; /* skroz lijevo */
        }

        .customer-box {
            padding-right: 0; /* skroz desno */
        }

            /* Stil naslova */
            .seller-customer-box h4, .customer-box h4 {
                border-bottom: 2px solid #000;
                padding-bottom: 6px;
                margin-bottom: 15px;
                font-weight: bold;
            }

            /* Tablice unutar boxeva */
            .seller-customer-box table, .customer-box table {
                width: 100%;
                border-collapse: collapse;
            }

            .seller-customer-box td, .customer-box td {
                border: none;
                padding: 6px 0;
            }

                .seller-customer-box td strong, .customer-box td strong {
                    display: inline-block;
                    width: 110px;
                }


    </style>
</head>
<body>

    <h2>PREDRAČUN br. @Model.InvoiceNumber</h2>

    <div class="section no-border" style="text-align:right;">
        <strong>Datum:</strong>
        @Model.IssueDate.ToString("dd.MM.yyyy")
    </div>

    <div class="seller-customer-container">
        <div class="seller-customer-box">
            @if (!string.IsNullOrEmpty(Model.SellerLogoDataUri))
            {
                <div style="margin-bottom: 15px;">
                    <img src="@Model.SellerLogoDataUri" alt="Logotip" style="max-height: 80px; max-width: 180px;" />
                </div>
            }
            <h4>Podaci o prodavatelju</h4>
            <table>
                <tr><td><strong>Naziv:</strong> @Model.SellerName</td></tr>
                <tr><td><strong>OIB:</strong> @Model.SellerOib</td></tr>
                <tr><td><strong>Adresa:</strong> @Model.SellerAddress, @Model.SellerPostal @Model.SellerCity</td></tr>
                @if (!string.IsNullOrWhiteSpace(Model.SellerIBAN))
                {
                    <tr><td><strong>IBAN:</strong> @Model.SellerIBAN</td></tr>
                }
            </table>
        </div>

        <div class="customer-box">
            <h4>Podaci o kupcu</h4>
            <table>
                <tr><td><strong>Naziv:</strong> @Model.CustomerName</td></tr>
                <tr><td><strong>OIB:</strong> @Model.CustomerOib</td></tr>
                <tr><td><strong>Adresa:</strong> @Model.CustomerStreet, @Model.CustomerPostalCode @Model.CustomerCity</td></tr>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                {
                    <tr><td><strong>Email:</strong> @Model.CustomerEmail</td></tr>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                {
                    <tr><td><strong>Telefon:</strong> @Model.CustomerPhone</td></tr>
                }
            </table>
        </div>
    </div>


    <div class="section">
        <h4>Stavke predračuna</h4>
        <table>
            <thead>
                <tr>
                    <th>Opis</th>
                    <th>Jedinica</th>
                    <th class="text-right">Količina</th>
                    <th class="text-right">Cijena</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Description</td>
                        <td>@item.Unit</td>
                        <td class="text-right">@item.Quantity</td>
                        <td class="text-right">@item.Price_Print</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="total">
        Ukupno: @Model.Amount_Print
    </div>

    <div class="section">
        <strong>Iznos slovima:</strong><br />
        @Model.AmountTxt
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <div class="section">
            <strong>Napomena:</strong><br />
            @Html.Raw(Model.Note)
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
    {
        <div class="qr-box">
            <img src="data:image/png;base64,@Model.QrCodeBase64" />
        </div>
    }

</body>
</html>
